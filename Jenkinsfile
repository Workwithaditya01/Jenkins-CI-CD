
pipeline {
    agent any

    stages {
        stage('Start') {
            steps {
                echo 'Jenkins pipeline has started!'
            }
        }

        stage('Build') {
            steps {
                echo 'Build stage is running successfully.'
            }
        }

        stage('Test') {
            steps {
                echo 'Test stage is running successfully.'
            }
        }

        stage('Finish') {
            steps {
                echo 'Jenkins pipeline completed successfully!'
            }
        }
    }
}
